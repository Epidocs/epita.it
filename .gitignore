# -- Generic rules:

# Environment files
.env*.local*

# Temporary files
._*
*.cache
*.log*
*.swp
*~

# System files
.DS_Store
Thumbs.db

# -- Editor rules:

# VS Code
.vscode/**/*
!.vscode/extensions.json

# Jetbrains
.idea/

# Other
*.njsproj
*.ntvs*
*.sln
*.suo
*.sw?

# -- Application rules:

# Node.js
.coverage/
.pnpm-store/
dist/
node_modules/
tsconfig*.tsbuildinfo

# Astro
.astro/
.vite/

# Playwright
blob-report/
playwright-report/
playwright/.cache/
test-results/

# Generated source files
generated/

# -- Service rules:

# All services
/*/data/
/*/**/.env*
