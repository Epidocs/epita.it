---
import { site } from '~/site'
---

<link rel="icon" sizes="48x48" href={`/assets/icon-48.png?v=${site.version}`} />
<link rel="icon" sizes="192x192" href={`/assets/icon-192.png?v=${site.version}`} />
<link rel="icon" sizes="512x512" href={`/assets/icon-512.png?v=${site.version}`} />
<link rel="apple-touch-icon" href={`/assets/apple-icon.png?v=${site.version}`} />
<link rel="manifest" href="/manifest.json" />

<script>window.twFallback=function(el){try{var d=el.dataset;var b=JSON.stringify({type:'event',payload:{website:d.websiteId,hostname:location.hostname,url:location.pathname+location.search,referrer:document.referrer,language:navigator.language,screen:screen.width+'x'+screen.height,title:document.title}});navigator.sendBeacon('https://u.mtbx.it/api/send',new Blob([b],{type:'application/json'}))}catch(e){}}</script><script defer src="https://u.mtbx.it/tw.js" data-website-id="89eb4e7e-94a7-4f03-8383-e41f78b1fc15" onerror="window.twFallback(this)"></script>
