---
import { APP_ENV } from 'astro:env/client'

import { site } from '~/site'
---

<link rel="icon" sizes="48x48" href={`/assets/icon-48.png?v=${site.version}`} />
<link rel="icon" sizes="192x192" href={`/assets/icon-192.png?v=${site.version}`} />
<link rel="icon" sizes="512x512" href={`/assets/icon-512.png?v=${site.version}`} />
<link rel="apple-touch-icon" href={`/assets/apple-icon.png?v=${site.version}`} />
<link rel="manifest" href="/manifest.json" />

{APP_ENV === 'prod' && (
	<script is:inline defer src="https://u.epidocs.eu/tw.js" data-website-id="89eb4e7e-94a7-4f03-8383-e41f78b1fc15" onerror="window.twFallback(this)"></script>
)}
